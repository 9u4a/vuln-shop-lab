# docker compose가 치환하는 변수들. `copy .env.example .env` 후 값을 채운다.

# Node 세션 시크릿 (미설정 시 compose가 dev 기본값 사용 — 실사용 시 반드시 변경)
NODE_SESSION_SECRET=change-me-in-real-use

# Toss Payments 테스트 키 (없어도 앱은 뜨고, 결제 단계에서만 안내 후 중단)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 참고: 아래 값은 docker compose에서 고정/기본값으로 주입되며 보통 건드릴 필요 없다.
#   MONGO_URL                = mongodb://mongo:27017   (node-express, compose에 고정)
#   CORS_ORIGIN(node)        = http://localhost:5173   (미설정 시 기본값)
#   APP_CORS_ALLOWED_ORIGIN(java) = http://localhost:5173,http://localhost:8090 (미설정 시 기본값)
