# node-express 단독 실행용 예시. docker compose로 띄우면 compose가 값을 주입한다.

PORT=3000
SESSION_SECRET=change-me-in-real-use

# API 토큰(JWT) 서명 시크릿 (미설정 시 dev-jwt-secret-please-change-0001)
JWT_SECRET=dev-jwt-secret-please-change-0001

# 프런트(개발 서버) 오리진 — CORS 허용 대상 (미설정 시 http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# 활동 피드(NoSQLi 데모)용 MongoDB (미설정 시 mongodb://localhost:27017)
MONGO_URL=mongodb://localhost:27017
